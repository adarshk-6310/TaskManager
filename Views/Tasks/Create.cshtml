@model TaskManager.Models.TaskModel

@{
    ViewData["Title"] = "Create Task";
}

<h2 class="mb-4">Create Task</h2>

<form asp-action="Create" method="post" class="card p-4 shadow-sm">

    <div class="mb-3">
        <label asp-for="TaskTitle" class="form-label"></label>
        <input asp-for="TaskTitle" class="form-control" placeholder="Enter task title" />
        <span asp-validation-for="TaskTitle" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TaskDescription" class="form-label"></label>
        <textarea asp-for="TaskDescription" class="form-control" rows="3"
                  placeholder="Enter task description"></textarea>
        <span asp-validation-for="TaskDescription" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TaskDueDate" class="form-label"></label>
        <input asp-for="TaskDueDate" type="date" class="form-control" />
        <span asp-validation-for="TaskDueDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TaskStatus" class="form-label"></label>
        <select asp-for="TaskStatus" class="form-select">
            <option value="">-- Select Status --</option>
            <option>Pending</option>
            <option>In Progress</option>
            <option>Completed</option>
        </select>
        <span asp-validation-for="TaskStatus" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CreatedBy" class="form-label"></label>
        <input asp-for="CreatedBy" class="form-control" placeholder="Created by user" oninput="createdByChanged(this.value)"/>
        <span asp-validation-for="CreatedBy" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TaskRemarks" class="form-label"></label>
        <input asp-for="TaskRemarks" class="form-control" placeholder="Remarks" />
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
    <input asp-for="LastUpdatedBy" type="hidden" id="LastUpdatedById" />

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<script>

    function createdByChanged(value){
        document.getElementById("LastUpdatedById").value = value;
    }

</script>

