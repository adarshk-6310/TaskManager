@model TaskManager.Models.TaskModel

<h2>Task Details</h2>

<hr />

<p><b>Title:</b> @Model.TaskTitle</p>
<p><b>Description:</b> @Model.TaskDescription</p>
<p><b>Status:</b> @Model.TaskStatus</p>
<p><b>Due Date:</b> @Model.TaskDueDate.ToShortDateString()</p>
<p><b>Remarks:</b> @Model.TaskRemarks</p>
<p><b>Created On:</b> @Model.CreatedOn</p>
<p><b>Created By:</b> @Model.CreatedBy</p>
<p><b>Last Updated On:</b> @Model.LastUpdatedOn</p>
<p><b>Last Updated By:</b> @Model.LastUpdatedBy</p>

<a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
<a asp-action="Index">Back to List</a>
